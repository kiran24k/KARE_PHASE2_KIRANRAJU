import java.util.*;
class Main
{
	public static void main(String[] args) {
		Scanner obj = new Scanner(System.in);
		int n = obj.nextInt();
		int arr[]=new int[n];
		int i,s=0;
		for(i=0;i<n;i++)
	    arr[i] = obj.nextInt();
	    int e = n-1;
	    while(s<e)
	    {
	        int temp = arr[s];
	        arr[s]= arr[e];
	        arr[e] =temp;
	        s++;
	        e--;
	    }
	    for(i=0;i<n;i++)
	    System.out.print(arr[i]+" ");
	}
}

