class Main{
    public static void main(String[] args){
        int a=4;
        int b=2;
        int res=a<<b;
        //left shift operator -->X*2^k
        System.out.println(res);
        //output-->16
        int d=4;
        int y=3;
        int c=d>>y;
        //righ shift operator -->x/2^k
        System.out.println(c);
        //output-->0
    }
}
