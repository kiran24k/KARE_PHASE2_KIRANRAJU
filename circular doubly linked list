import java.util.*;
class Node{
    int data;
    Node next,prev;
    Node(int d){
        this.data = d;
        this.next = null;
        this.prev = null;
    }
}
public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    int d = sc.nextInt();
	    Main m = new Main();
	    while(d!=1){
	        m.insert(d);
	        d = sc.nextInt();
	    }
	    m.display();
	}
	Node   first = null;
	void insert(int d){
	    Node n = new Node(d);
	    if(first == null) {
	        first = n;
	        n.next = first;
	        n.prev = first;
	    } else {
	        Node temp = first;
	        while(temp.next != first){
	            temp = temp.next;
	            temp.next = n;
	            n.next = first;
	            n.prev = temp;
	            first.prev = n;
	        }
	    }
	}
	void display(){
	   if(first == null)
	   System.out.println("List is empty");
	   Node temp = first;
	   do {
	       System.out.print(temp.data+" ");
	       temp = temp.next;
	       }
	       while(temp != first);
   }
}
