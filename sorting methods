//bubble sort
import java.util.*;
class Main{
    public static void main(String args[]){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int arr[] = new int[n];
        int i,j;
        for(i =0;i<n;i++)
        arr[i] = obj.nextInt();
        for(i = 0;i<n;i++){
            for(j=0;j<n;j++){
                if(arr[j]>arr[j+1]){
                    int temp = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] =temp;
                }
            }
        }
        for(i=0;i<n;i++)
        System.out.print(arr[i]+" ");
        
    }
}

//insertion sort
import java.util.*;
class Main{
    public static void main(String args[]){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int arr[] = new int[n];
        int i;
        for(i =0;i<n;i++)
        arr[i] = obj.nextInt();
        for(i = 1;i<n;i++){
           int key = arr[i];
           int j = i -1;
           while(j >= 0 && arr[j] > key){
               arr[j+1] = arr[j];
               j--;
           }
            arr[j+1] = key;
       }
        for(i=0;i<n;i++)
        System.out.print(arr[i]+" ");
        
    }
} 
